# Server
PORT=5000
NODE_ENV=development
# Public base URL used to build links to uploaded files
PUBLIC_URL=http://localhost:5000

# PostgreSQL
DATABASE_URL=postgres://fastchat:fastchat@localhost:5432/fastchat

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# CORS (comma-separated; leave empty to allow all — the mobile app sends no Origin)
CLIENT_URL=

# Email (Gmail SMTP with an App Password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password

# Optional
EXPO_ACCESS_TOKEN=

# ─── Billing ──────────────────────────────────────────────────────────────────
# Public website URL (Paddle checkout success redirect, portal links)
SITE_URL=https://fastchatwebsite.hosensoft.com

# Paddle Billing. Leave PADDLE_ENVIRONMENT empty to turn billing off.
# Set it to "sandbox" or "live" ("production" also means live). The server then refuses to
# start unless the API key, client token and webhook secret are present and belong to that
# environment (sandbox: pdl_sdbx_apikey_… / test_…, live: pdl_live_apikey_… / live_…).
# Sandbox and live price IDs are different; never mix them. Never commit real values.
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
# Client-side token (public; sent to the browser for Paddle.js)
PADDLE_CLIENT_TOKEN=
# Notification destination secret (Paddle → Developer tools → Notifications), not the API key
PADDLE_WEBHOOK_SECRET=
# Checkout stays closed until this is "true" (keep false on live until verification + domain approval)
PADDLE_CHECKOUT_ENABLED=false
# Paddle price IDs (pri_…). Amounts, billing cycles and trials are read from Paddle itself.
# A missing ID only makes that option unavailable; it is never replaced by a guess.
PADDLE_STARTER_MONTHLY_PRICE_ID=
PADDLE_STARTER_YEARLY_PRICE_ID=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_YEARLY_PRICE_ID=
# One-time price (no billing cycle): permanent Advanced access
PADDLE_ADVANCED_LIFETIME_PRICE_ID=

# Access rules (see services/entitlements.js)
# Days a past_due subscription keeps paid access while payment is retried (default 7)
BILLING_PAST_DUE_GRACE_DAYS=7
# Paused subscriptions lose paid access unless "true"
BILLING_PAUSED_KEEPS_ACCESS=false
